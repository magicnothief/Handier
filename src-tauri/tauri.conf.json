{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Handy Flow",
  "version": "0.9.6",
  "identifier": "com.magicnothief.handyflow",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "MagicNoThief",
    "homepage": "https://github.com/MagicNoThief/Handy-Flow",
    "copyright": "Copyright (c) 2025 CJ Pais and Handy-Flow contributors. MIT licensed.",
    "licenseFile": "../LICENSE",
    "shortDescription": "Offline speech-to-text that cleans up your dictation locally.",
    "externalBin": ["binaries/handy-llm"],
    "createUpdaterArtifacts": true,
    "resources": ["resources/**/*"],
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libgtk-layer-shell0", "libopenblas0"],
        "files": {
          "/usr/lib/Handy": "transcribe-libs"
        }
      },
      "rpm": {
        "depends": [
          "libgtk-layer-shell.so.0()(64bit)",
          "libopenblas.so.0()(64bit)"
        ],
        "compression": {
          "type": "none"
        },
        "files": {
          "/usr/lib/Handy": "transcribe-libs"
        }
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib": "transcribe-libs"
        }
      }
    },
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGOEZGMjkwQjc0RTczQjQKUldTMGMwNjNrUEtQNzA0Tm05SHNsdWc1aGkzNC84TTlVak5KMHdtUDV1N3YvMWhRd1dZT0hKTE0K",
      "endpoints": [
        "https://github.com/MagicNoThief/Handy-Flow/releases/latest/download/latest.json"
      ]
    }
  }
}
