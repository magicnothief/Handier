# Nix build output
result

# Python bytecode (scripts/)
__pycache__/

# Inference sidecar build output. The crate has its own target directory
# because it is built separately from the app (see crates/handy-llm/README.md).
/src-tauri/crates/*/target/

# Local agent scratch state, not part of the project.
/.headroom/

# Updater signing keys. Committing one lets anyone publish an update that the
# app will accept as genuine, so keep them out of the tree entirely --
# `tauri signer generate` writes here by default if you are not careful.
*.key
*.key.pub
!**/node_modules/**/*.key
